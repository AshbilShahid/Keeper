# KEEPER is fully functional WITHOUT any of these — the optimizer and
# core engine never depend on an external API. These only enable the
# optional AI explanation layer (Step 18 in the roadmap).

# Which AI provider to use for generating plain-language explanations
# of an already-computed optimization result. Leave unset to disable.
AI_PROVIDER=

# API key for whichever provider you configure above.
AI_API_KEY=

# Optional: override default city/scenario without editing config/city.json
KEEPER_CITY=lahore
KEEPER_SCENARIO=flood
